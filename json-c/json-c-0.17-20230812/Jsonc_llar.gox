import (
	"os"
	"path/filepath"
	"slices"
)

id "json-c/json-c"

fromVer "json-c-0.17-20230812"

onBuild ctx => {
	installDir := ctx.outputDir
	c := cmake.new(ctx.SourceDir, ctx.SourceDir+"/_build", installDir)

	// Keep a standard lib/ layout so the installed pkg-config file and the
	// dependency search paths resolve without lib64 handling.
	c.define "CMAKE_INSTALL_LIBDIR", "lib"
	// Build the static archive with position-independent code, matching the
	// Conan recipe defaults (shared=False, fPIC=True). json-c builds its
	// shared and static libraries from independent targets, so select the
	// static one and leave DISABLE_STATIC_FPIC off to keep -fPIC.
	c.defineBool "BUILD_SHARED_LIBS", false
	c.defineBool "BUILD_STATIC_LIBS", true
	c.defineBool "DISABLE_STATIC_FPIC", false
	// Library-only install: skip the upstream test suite and CLI apps.
	c.defineBool "BUILD_TESTING", false
	c.defineBool "BUILD_APPS", false

	c.configure
	c.build
	c.install

	// Overwrite cmake-installed json-c.pc. This Formula is static-only, so
	// unix math belongs on public Libs; pkgconfig.lookup does not pass --static.
	libs := ["-L$${libdir}", "-ljson-c"]
	if slices.contains(target.require["os"], "linux") {
		libs <- "-lm"
	}

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "json-c",
		description = "JSON-C library",
		version = "json-c-0.17-20230812",
		libs = libs,
		cflags = ["-I$${includedir}", "-I$${includedir}/json-c"],
	)!
	out := os.create(filepath.join(pcDir, "json-c.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("json-c")!
}

onTest ctx => {
	installDir := ctx.outputDir

	// Build the consumer in a tree independent of the onBuild scratch tree so
	// the test also runs on a cache hit, where onBuild is skipped.
	testDir := ctx.SourceDir + "/_llar_consumer"

	// Conan includedirs are include plus include/json-c, so consumers may
	// write #include <json.h>. Using only <json-c/json.h> hides a missing
	// -I${includedir}/json-c on the published .pc.
	source := `#include <json.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    json_object *jobj = json_object_new_object();
    json_object *jarray = json_object_new_array();
    json_object_array_add(jarray, json_object_new_string("c"));
    json_object_array_add(jarray, json_object_new_string("c++"));
    json_object_object_add(jobj, "Categories", jarray);
    printf("%s\n", json_object_to_json_string(jobj));
    json_object_put(jobj);

    json_object *parsed = json_tokener_parse("{\"n\":7,\"s\":\"llar\"}");
    json_object *n;
    json_object *s;
    if (parsed == NULL) {
        return 1;
    }
    n = json_object_object_get(parsed, "n");
    s = json_object_object_get(parsed, "s");
    if (json_object_get_int(n) != 7) {
        json_object_put(parsed);
        return 1;
    }
    if (strcmp(json_object_get_string(s), "llar") != 0) {
        json_object_put(parsed);
        return 1;
    }
    json_object_put(parsed);
    return EXIT_SUCCESS;
}
`
	os.mkdirAll(testDir, 0755)!
	os.writeFile(testDir+"/consumer.c", []byte(source), 0644)!

	pkgconfig.use installDir
	flags := pkgconfig.lookup("json-c")!
	flagsFile := testDir + "/json-c.flags"
	os.writeFile(flagsFile, []byte(flags), 0644)!

	binary := testDir + "/consumer"
	cc! testDir+"/consumer.c", "-o", binary, "@"+flagsFile
	exec! binary
}
