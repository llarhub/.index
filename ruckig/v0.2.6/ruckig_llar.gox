import (
	"os"
	"path/filepath"
)

id "pantor/ruckig"

fromVer "v0.2.6"

onBuild ctx => {
	installDir := ctx.outputDir

	c := cmake.new(ctx.SourceDir, filepath.join(ctx.SourceDir, "_build"), installDir)
	c.buildType "Release"

	// Build only the core static library:
	// disable the examples, unit tests, the nanobind Python wrapper and the
	// (network) cloud client, matching the community package interface. The
	// cloud client would otherwise inject vendored third_party headers and a
	// WITH_CLOUD_CLIENT define that are not part of the core install.
	c.defineBool "BUILD_SHARED_LIBS", false
	c.defineBool "CMAKE_POSITION_INDEPENDENT_CODE", true
	c.defineBool "BUILD_EXAMPLES", false
	c.defineBool "BUILD_TESTS", false
	c.defineBool "BUILD_PYTHON_MODULE", false
	c.defineBool "BUILD_CLOUD_CLIENT", false
	c.define "CMAKE_INSTALL_LIBDIR", "lib"

	c.configure
	c.build
	c.install

	pcDir := filepath.join(installDir, "lib", "pkgconfig")
	os.mkdirAll(pcDir, 0o755)!
	pc := pkgconfig.new(
		name = "ruckig",
		description = "ruckig motion library",
		version = "v0.2.6",
		libs = ["-L$${libdir}", "-lruckig"],
		cflags = ["-I$${includedir}"],
	)!
	out := os.create(filepath.join(pcDir, "ruckig.pc"))!
	pc.writeTo(out)!
	out.close()!

	pkgconfig.use installDir
	ctx.setMetadata pkgconfig.lookup("ruckig")!
}

onTest ctx => {
	installDir := ctx.outputDir

	// Keep the consumer build in its own tree so onTest behaves identically
	// on a cache hit (onBuild skipped, no _build dir) and a cache miss.
	testDir := filepath.join(ctx.SourceDir, "_testconsumer")
	testBuild := filepath.join(testDir, "_build")

	os.mkdirAll(testDir, 0o755)!

	// Consumer mirrors the Conan test_package: a single-DoF trajectory update.
	cpp := `#include <cstdio>
#include <ruckig/ruckig.hpp>

int main() {
    using namespace ruckig;

    Ruckig<1> otg(0.01);
    InputParameter<1> input;
    OutputParameter<1> output;

    input.current_position = {0.0};
    input.current_velocity = {0.0};
    input.current_acceleration = {0.0};
    input.target_position = {1.0};
    input.max_velocity = {1.0};
    input.max_acceleration = {1.0};
    input.max_jerk = {1.0};

    auto result = otg.update(input, output);
    printf("Ruckig update result: %d\n", static_cast<int>(result));
    return 0;
}
`
	os.writeFile(filepath.join(testDir, "test_package.cpp"), []byte(cpp), 0o644)!

	cml := `cmake_minimum_required(VERSION 3.10)
project(ruckig_test_package LANGUAGES CXX)

find_package(ruckig REQUIRED CONFIG)

add_executable(test_package test_package.cpp)
target_link_libraries(test_package PRIVATE ruckig::ruckig)
`
	os.writeFile(filepath.join(testDir, "CMakeLists.txt"), []byte(cml), 0o644)!

	tc := cmake.new(testDir, testBuild, filepath.join(testBuild, "_out"))
	tc.buildType "Release"
	tc.use installDir

	tc.configure
	tc.build

	binary := filepath.join(testBuild, "test_package")
	exec! binary

	// Also compile against the published pkg-config flags so a cache-hit
	// consumer proves ruckig.pc, not only the CMake package files.
	pkgconfig.use installDir
	flagsFile := filepath.join(testDir, "ruckig.flags")
	os.writeFile(flagsFile, []byte(pkgconfig.lookup("ruckig")!), 0o644)!
	pcBinary := filepath.join(testDir, "test_package_pc")
	exec! "c++", "-std=c++17", filepath.join(testDir, "test_package.cpp"), "-o", pcBinary, "@"+flagsFile
	exec! pcBinary
}
